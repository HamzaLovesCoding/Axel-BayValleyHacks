# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key. Without it, the app uses the keyword demo instead of the AI model.
ANTHROPIC_API_KEY=

# Address of the bridge program running next to the arm (bridge/, docs/contracts.md).
# Without it, only the simulator works. `npm run bridge:dry` listens on 8787.
ROBOT_BRIDGE_URL=http://localhost:8787

# Optional shared secret, sent to the bridge as "Authorization: Bearer <token>".
ROBOT_BRIDGE_TOKEN=

# Which serial port the Arduino is on, for `npm run bridge` (or pass --serial).
ARM_SERIAL_PORT=

# whisper.cpp server on this laptop, for speech-to-text. Without it, the browser's own engine is used.
WHISPER_URL=

# ElevenLabs, for the spoken replies. Without both, the browser's own voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Required before any public tunnel. Use a long, unique passcode (12+ characters recommended).
# Unset: development only is open with a warning; production refuses access.
APP_PASSCODE=
