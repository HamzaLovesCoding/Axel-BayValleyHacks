# Optional services. Copy to .env.local; never commit credentials.
# Without provider keys, the app uses keyword commands and the browser voice.
ANTHROPIC_API_KEY=
WHISPER_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Set a long, unique passcode before exposing the app publicly.
# Development is open when unset; production refuses access.
APP_PASSCODE=

# App-side integration placeholders only. Hardware code is not included.
# Leave empty to use the simulator in Setup.
ROBOT_BRIDGE_URL=
ROBOT_BRIDGE_TOKEN=
