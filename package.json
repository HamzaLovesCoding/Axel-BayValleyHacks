{
  "name": "arm-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:phone": "next dev --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bridge:mock": "node scripts/mock-bridge.mjs",
    "bridge": "node --env-file-if-exists=.env.local bridge/main.ts",
    "bridge:dry": "node --env-file-if-exists=.env.local bridge/main.ts --dry-run",
    "jog": "node --env-file-if-exists=.env.local bridge/jog.ts",
    "whisper": "whisper-server -m \"$HOME/.cache/whisper.cpp/ggml-base.en.bin\" --host 127.0.0.1 --port 8080 --convert",
    "tunnel": "node --env-file-if-exists=.env.local scripts/tunnel.mjs",
    "test": "node --test \"bridge/**/*.test.ts\" && node --import ./scripts/test-register.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p bridge",
    "preflight": "node --env-file-if-exists=.env.local bridge/preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@serialport/parser-readline": "^13.0.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serialport": "^13.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
